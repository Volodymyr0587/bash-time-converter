#!/usr/bin/env bash

show_help() {
cat << EOF
timeconvert — Convert time formats

Usage:
  timeconvert [OPTIONS] <time>

Formats supported:
  seconds        3661
  H:M:S          01:01:01
  M:S            12:30
  human          1h 2m 3s

Examples:
  timeconvert 3661
  timeconvert 01:01:01
  timeconvert 12:30
  timeconvert "1h 2m 3s"

Options:
  -h        Show this help
EOF
}

# --- option parsing ---

while getopts ":h" opt; do
    case $opt in
        h)
            show_help
            exit 0
            ;;
        \?)
            echo "Unknown option: -$OPTARG" >&2
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

# long option support
if [[ "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# --- argument check ---

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

input="$*"

# --- conversion functions ---

sec_to_hms() {
    local sec=$1
    printf "%02d:%02d:%02d\n" \
        $((sec/3600)) \
        $(((sec%3600)/60)) \
        $((sec%60))
}

hms_to_sec() {
    IFS=':' read -r h m s <<< "$1"
    echo $((h*3600 + m*60 + s))
}

ms_to_sec() {
    IFS=':' read -r m s <<< "$1"
    echo $((m*60 + s))
}

human_to_sec() {
    local total=0

    if [[ "$input" =~ ([0-9]+)h ]]; then
        total=$(( total + ${BASH_REMATCH[1]} * 3600 ))
    fi

    if [[ "$input" =~ ([0-9]+)m ]]; then
        total=$(( total + ${BASH_REMATCH[1]} * 60 ))
    fi

    if [[ "$input" =~ ([0-9]+)s ]]; then
        total=$(( total + ${BASH_REMATCH[1]} ))
    fi

    echo "$total"
}

# --- format detection ---

if [[ "$input" =~ ^[0-9]+$ ]]; then
    sec_to_hms "$input"

elif [[ "$input" =~ ^[0-9]+:[0-9]{2}:[0-9]{2}$ ]]; then
    hms_to_sec "$input"

elif [[ "$input" =~ ^[0-9]+:[0-9]{2}$ ]]; then
    ms_to_sec "$input"

elif [[ "$input" =~ [0-9]+h|[0-9]+m|[0-9]+s ]]; then
    human_to_sec

else
    echo "Invalid format." >&2
    echo "Run 'timeconvert --help' for usage." >&2
    exit 1
fi